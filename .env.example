# ─── Plex / Tautulli ────────────────────────────────────────────
PLEX_URL=
PLEX_TOKEN=

TAUTULLI_URL=
TAUTULLI_API_KEY=

# Comma-separated Plex usernames to monitor. Case-sensitive.
MONITORED_USERS=

# ─── Ollama (main PC) ───────────────────────────────────────────
OLLAMA_URL=
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=600

# ─── Discord ────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# Optional: separate webhook for prep-complete / system notifications.
# Leave blank to use DISCORD_WEBHOOK_URL for both.
DISCORD_SYSTEM_WEBHOOK_URL=

# ─── Source material APIs ──────────────────────────────────────
TMDB_API_KEY=

# ─── Playback timing ───────────────────────────────────────────
CARD_LEAD_TIME_SECONDS=7
SESSION_POLL_INTERVAL_SECONDS=3
MISSED_CARD_THRESHOLD_SECONDS=30

# ─── Prep pipeline ─────────────────────────────────────────────
TARGET_CARDS_PER_MOVIE=50
MAX_CARDS_PER_MOVIE=70

# ─── Container paths ───────────────────────────────────────────
# These should match the volume mounts in docker-compose.yml. MEDIA_DIR is
# informational; the container uses whatever absolute file path Tautulli
# reports, so the host media root must be mounted at that SAME path inside
# the container.
CONFIG_DIR=/config
MEDIA_DIR=/mnt/user/data/media
TRACKS_DIR=/config/tracks
CACHE_DIR=/config/cache

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
