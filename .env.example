# ─── Plex / Tautulli ────────────────────────────────────────────
# PLEX_URL + PLEX_TOKEN are required for the Plex auto-subtitle path:
# when a movie has no embedded text subs and no sidecar SRT, poptrivia
# asks Plex for any subtitle Plex itself downloaded (OpenSubtitles agent,
# auto-download, etc.). Plex stores those subs in its metadata dir so
# you can't find them as sidecars — only the API exposes them.
PLEX_URL=
PLEX_TOKEN=

TAUTULLI_URL=
TAUTULLI_API_KEY=

# Comma-separated Plex usernames to monitor. Case-sensitive.
MONITORED_USERS=

# ─── Ollama (main PC) ───────────────────────────────────────────
OLLAMA_URL=
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=600
# Context window per request. 12288 fits our largest prompt (Stage 2:
# system + examples + facts + 15 min of subtitles ≈ 8k tokens) with
# generation headroom. Don't raise without reason — larger num_ctx eats
# VRAM and reduces how many requests can run concurrently.
OLLAMA_NUM_CTX=12288

# ─── Whisper (optional GPU subtitle fallback) ──────────────────
# Used when a movie has no embedded text subs and no sidecar SRT.
# Point at a Speaches / faster-whisper-server instance (OpenAI-compatible)
# running on a GPU host. Leave blank to disable — prep then fails for
# movies with image-based (PGS / VOBSUB) subs only.
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_TIMEOUT=3600

# ─── Discord ────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# Optional: separate webhook for prep-complete / system notifications.
# Leave blank to use DISCORD_WEBHOOK_URL for both.
DISCORD_SYSTEM_WEBHOOK_URL=

# ─── Source material APIs ──────────────────────────────────────
TMDB_API_KEY=

# ─── Playback timing ───────────────────────────────────────────
CARD_LEAD_TIME_SECONDS=7
SESSION_POLL_INTERVAL_SECONDS=3
MISSED_CARD_THRESHOLD_SECONDS=30

# ─── Prep pipeline ─────────────────────────────────────────────
TARGET_CARDS_PER_MOVIE=50
MAX_CARDS_PER_MOVIE=70

# ─── Tracked list (curated mode) ───────────────────────────────
# A text file with one IMDB id (or Plex GUID) per line. Only movies on
# this list get prep queued and cards fired. Edit any time; poptrivia
# polls it on the interval below and consults it on every playback.
TRACKED_LIST_PATH=/config/tracked.txt
TRACKED_POLL_INTERVAL_SECONDS=1800

# ─── Container paths ───────────────────────────────────────────
# These should match the volume mounts in docker-compose.yml. MEDIA_DIR is
# informational; the container uses whatever absolute file path Tautulli
# reports, so the host media root must be mounted at that SAME path inside
# the container.
CONFIG_DIR=/config
MEDIA_DIR=/data
TRACKS_DIR=/config/tracks
CACHE_DIR=/config/cache

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
